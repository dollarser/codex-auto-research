# Copy to <project>/research/config.toml.
# Environment variables AUTO_RESEARCH_* override these values.

[codex]
model = "gpt-5.6-terra"
approval_policy = "never"
sandbox = "workspace-write"

# Legacy Desktop compatibility only. Keep disabled for the managed App Server
# Supervisor. Set true explicitly only for an existing Desktop Listener task.
[listener]
auto_wake = false
app_server_response_timeout_s = 60.0
bind_recency_s = 600.0
reconnect_initial_s = 2.0
reconnect_max_s = 60.0
event_poll_s = 0.25
event_grace_s = 30.0

[experiment]
use_shell = true
allowed_executables = ["python", "python3"]
default_timeout_s = 3600
worker_heartbeat_s = 5.0
one_active_experiment = true
